  "bookSourceUrl": "http://127.0.0.1:8000",
  "bookSourceGroup": "自建书库",
  "bookSourceComment": "自建小说站的只读 JSON 接口。\n换地址时把本源里所有 http://127.0.0.1:8000 替换成实际可访问的地址；\n服务端设置了 API_TOKEN 的话，四个 url 都要带同一个 token 参数。",
  "enabled": true,
  "enabledExplore": true,
  "enabledCookieJar": false,
  "customOrder": 0,
  "weight": 0,
