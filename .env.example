# 复制成 .env 就生效（.env 已在 .gitignore 里）。
# 优先级：系统环境变量 > 本文件 > 内置默认值。
# 支持整行 # 注释、可选的 export 前缀、成对的引号；不支持行尾注释。

# 后台密码。留空或删掉这一行，每次启动会随机生成一个并打印到日志
ADMIN_PASSWORD=换成你自己的密码

# 会话 cookie 签名密钥。不固定的话每次重启都会把已登录的会话踢下线
# 生成一串：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=换成一串足够长的随机字符

# 写进书源和 API 返回 URL 的对外地址。手机要访问电脑就填局域网 IP
SITE_BASE_URL=http://127.0.0.1:8000

# 站名与副标题
# SITE_NAME=青灯书斋
# SITE_TAGLINE=一盏灯，一本书

# 给 /api/* 加令牌。留空则公开（书源抓取通常需要免鉴权）
# API_TOKEN=

# 数据目录与库文件位置（Docker 下这两项由 docker-compose.yml 接管，写在这里没用）
# NOVEL_DATA_DIR=data
# NOVEL_DB_PATH=data/novel.db

# run.py 用的监听设置（Docker 下不生效，容器里固定 0.0.0.0:8000）
# HOST=127.0.0.1
# PORT=8000
# RELOAD=1

# ---------------------------------------------------------------- 只有 Docker 用得到
# 这三项被 docker-compose.yml 读走，不是 app/config.py 的配置项。
# 注意：compose 解析本文件时不认 `export ` 前缀，值也别加引号。

# 挂载卷 ./data 里用哪个库文件。换库就改这里再 `docker compose up -d`
# DB_FILE=novel.db

# 宿主机端口，以及绑在哪个地址上。
# 默认只绑 127.0.0.1，靠前面的 nginx 出去；要直接暴露到公网才改 0.0.0.0
# HOST_PORT=8000
# BIND_ADDR=127.0.0.1
